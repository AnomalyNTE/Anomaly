cmake_minimum_required(VERSION 3.22)

# The preview owns this generated package mirror; keep runtime state and settings.
set(preview_plugins "${ANOMALY_PREVIEW_ROOT}/plugins")
set(preview_packages "@ANOMALY_PREVIEW_PACKAGE_NAMES@")
file(REAL_PATH "${ANOMALY_PREVIEW_ROOT}" preview_root)
file(REAL_PATH "@CMAKE_BINARY_DIR@" preview_build_root)
cmake_path(IS_PREFIX preview_build_root "${preview_root}" NORMALIZE preview_in_build)
if(NOT preview_in_build OR NOT preview_root MATCHES "/Anomaly$")
    message(FATAL_ERROR "Preview staging must stay inside the build tree")
endif()
file(MAKE_DIRECTORY "${preview_plugins}")
file(GLOB preview_existing LIST_DIRECTORIES TRUE "${preview_plugins}/*")
foreach(preview_package IN LISTS preview_existing)
    if(NOT IS_DIRECTORY "${preview_package}" OR NOT EXISTS "${preview_package}/manifest.json")
        continue()
    endif()
    file(REAL_PATH "${preview_package}" preview_package_root)
    cmake_path(IS_PREFIX preview_root "${preview_package_root}" NORMALIZE preview_confined)
    if(NOT preview_confined)
        message(FATAL_ERROR "Preview package escapes the generated runtime tree")
    endif()
    file(REMOVE_RECURSE "${preview_package}")
endforeach()
foreach(preview_name IN LISTS preview_packages)
    file(MAKE_DIRECTORY "${preview_plugins}/${preview_name}")
endforeach()
@ANOMALY_PREVIEW_PACKAGE_COMMANDS@
set(ANOMALY_RUNTIME_ROOT "${ANOMALY_PREVIEW_ROOT}")
include("@CMAKE_SOURCE_DIR@/cmake/initialize_runtime_config.cmake")
file(COPY_FILE "@CMAKE_SOURCE_DIR@/CONTACT" "${ANOMALY_PREVIEW_ROOT}/CONTACT" ONLY_IF_DIFFERENT)
