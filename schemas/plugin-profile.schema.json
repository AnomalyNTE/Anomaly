{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anomaly.dev/schemas/plugin-profile.schema.json",
  "title": "Anomaly Plugin Compatibility Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "game", "module", "section", "contract", "layout", "symbols"],
  "properties": {
    "$schema": { "type": "string", "maxLength": 512 },
    "schemaVersion": { "const": 1 },
    "game": { "$ref": "#/definitions/id" },
    "module": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9_.-]+$" },
    "section": { "type": "string", "minLength": 1, "maxLength": 8, "pattern": "^[A-Za-z0-9_.]+$" },
    "contract": { "$ref": "#/definitions/id" },
    "layout": { "$ref": "#/definitions/values" },
    "symbols": {
      "type": "array", "minItems": 0, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "candidates"],
        "properties": {
          "name": { "$ref": "#/definitions/id" },
          "candidates": {
            "type": "array", "minItems": 1, "maxItems": 16,
            "items": { "$ref": "#/definitions/candidate" }
          }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
    "values": {
      "type": "object", "maxProperties": 256,
      "propertyNames": { "$ref": "#/definitions/id" },
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["pattern", "entry", "values"],
      "properties": {
        "pattern": {
          "type": "string", "minLength": 2, "maxLength": 4096,
          "pattern": "^([A-Fa-f0-9]{2}|\\?\\?)( ([A-Fa-f0-9]{2}|\\?\\?))*$"
        },
        "entry": {
          "type": "string", "minLength": 2, "maxLength": 767,
          "pattern": "^[A-Fa-f0-9]{2}( [A-Fa-f0-9]{2})*$"
        },
        "callOffset": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "values": { "$ref": "#/definitions/values" }
      }
    }
  }
}
