{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anomaly.dev/schemas/repository-index.schema.json",
  "title": "Anomaly Repository Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repositoryId", "sequence", "generatedAt", "expiresAt", "artifacts", "signature"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "repositoryId": { "$ref": "#/definitions/qualifiedId" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "generatedAt": { "$ref": "#/definitions/timestamp" },
    "expiresAt": { "$ref": "#/definitions/timestamp" },
    "artifacts": {
      "type": "array", "maxItems": 10000,
      "items": { "$ref": "#/definitions/artifact" }
    },
    "signature": { "$ref": "#/definitions/signature" }
  },
  "definitions": {
    "qualifiedId": {
      "type": "string", "minLength": 3, "maxLength": 255,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "artifactId": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^[^\\x00-\\x1F\\x7F]+$"
    },
    "timestamp": {
      "type": "string", "minLength": 20, "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "ecdsa-p256-sha256" },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
        "value": { "type": "string", "pattern": "^[0-9a-fA-F]{128}$" }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "version", "channel", "uri", "size", "sha256", "manifestSha256", "publishedAt", "withdrawn", "signature"],
      "properties": {
        "kind": { "enum": ["plugin", "nte-profile"] },
        "id": { "$ref": "#/definitions/artifactId" },
        "version": { "type": "string", "minLength": 5, "maxLength": 128 },
        "channel": { "enum": ["stable", "preview", "nightly"] },
        "uri": { "type": "string", "minLength": 8, "maxLength": 4096, "pattern": "^(https://|file://)" },
        "size": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "manifestSha256": { "$ref": "#/definitions/sha256" },
        "publishedAt": { "$ref": "#/definitions/timestamp" },
        "minimumRuntime": { "type": "string", "maxLength": 128 },
        "minimumApi": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "withdrawn": { "type": "boolean" },
        "withdrawnAt": { "$ref": "#/definitions/timestamp" },
        "withdrawalReason": { "type": "string", "maxLength": 1024 },
        "signature": { "$ref": "#/definitions/signature" }
      },
      "allOf": [
        { "if": { "properties": { "withdrawn": { "const": true } } },
          "then": { "required": ["withdrawnAt", "withdrawalReason"] } }
      ]
    }
  }
}
