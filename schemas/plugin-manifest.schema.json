{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anomaly.dev/schemas/plugin-manifest.schema.json",
  "title": "Anomaly Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "entry",
    "api",
    "games",
    "builds",
    "loadPhase"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "id": {
      "$ref": "#/definitions/pluginId"
    },
    "name": {
      "$ref": "#/definitions/displayName"
    },
    "description": {
      "$ref": "#/definitions/descriptionText"
    },
    "version": {
      "$ref": "#/definitions/semanticVersion"
    },
    "author": {
      "$ref": "#/definitions/displayName"
    },
    "license": {
      "$ref": "#/definitions/licenseIdentifier"
    },
    "audience": {
      "type": "string",
      "enum": ["user", "developer"]
    },
    "entry": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "pattern": "^[^\\x00-\\x1F\\x7F]+\\.dll$"
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minMinor", "maxMinor"],
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "minMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "maxMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "games": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/gameId"
      }
    },
    "builds": {
      "description": "Each pattern must use <game-id>-<non-empty-build-pattern> for one declared game; each game must own a pattern and game IDs must not overlap on that boundary.",
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/buildPattern"
      }
    },
    "loadPhase": {
      "type": "string",
      "enum": ["game-ready"]
    },
    "dependencies": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/definitions/pluginDependency"
      }
    },
    "services": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/definitions/serviceRequirement"
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/capability"
      }
    }
  },
  "definitions": {
    "qualifiedId": {
      "description": "Service or dependency identifier. Shares the segment syntax with pluginId but may carry additional namespace depth (for example anomaly.nte.player-teleport).",
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "pluginId": {
      "description": "Plugin package identifier, exactly two segments: <author>.<plugin>. The first segment is the author namespace in lower case, written the way the author signs it (CCYellowStar -> ccyellowstar, Mou-Mou-SaMa -> mou-mou-sama); the second is the plugin name. Author and plugin name are each lower-case kebab-case, so neither may carry a dot of its own. Source-tracking segments (local, builtin, plugin), reverse-domain prefixes and any third segment are rejected.",
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^(?!(?:local|builtin|plugin|example|com|org|net|io|dev|cn|co|me)\\.)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1F\\x7F]+$"
    },
    "descriptionText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\x00-\\x1F\\x7F]+$"
    },
    "licenseIdentifier": {
      "description": "SPDX license identifier for the plugin package",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$"
    },
    "semanticVersion": {
      "type": "string",
      "maxLength": 128
    },
    "versionRange": {
      "type": "string",
      "maxLength": 512
    },
    "gameId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "buildPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9._-]*\\*?$"
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "pluginDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "$ref": "#/definitions/pluginId"
        },
        "version": {
          "$ref": "#/definitions/versionRange"
        },
        "optional": {
          "type": "boolean"
        }
      }
    },
    "serviceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minVersion"],
      "properties": {
        "id": {
          "$ref": "#/definitions/qualifiedId"
        },
        "minVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "optional": {
          "type": "boolean"
        }
      }
    }
  }
}
