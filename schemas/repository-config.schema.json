{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anomaly.dev/schemas/repository-config.schema.json",
  "title": "Anomaly Repository Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "enabled",
    "allowFileSources",
    "withdrawalPolicy",
    "freshness",
    "sources",
    "trustKeys"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "enabled": { "type": "boolean" },
    "allowFileSources": { "type": "boolean" },
    "withdrawalPolicy": { "const": "block-new" },
    "freshness": { "$ref": "#/definitions/freshness" },
    "sources": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/definitions/source" }
    },
    "trustKeys": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/definitions/trustKey" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "properties": {
          "sources": { "minItems": 1 },
          "trustKeys": { "minItems": 1 }
        }
      }
    }
  ],
  "definitions": {
    "qualifiedId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "uri": {
      "type": "string",
      "minLength": 8,
      "maxLength": 4096,
      "pattern": "^(https://|file://)"
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumClockSkewSeconds",
        "maximumIndexAgeSeconds",
        "maximumOfflineAgeSeconds",
        "downgradePolicy"
      ],
      "properties": {
        "maximumClockSkewSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "maximumIndexAgeSeconds": { "type": "integer", "minimum": 60, "maximum": 2678400 },
        "maximumOfflineAgeSeconds": { "type": "integer", "minimum": 0, "maximum": 7776000 },
        "downgradePolicy": { "const": "reject" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "indexUri", "channel", "keyIds", "mirrors", "mirrorPolicy"],
      "properties": {
        "id": { "$ref": "#/definitions/qualifiedId" },
        "indexUri": { "$ref": "#/definitions/uri" },
        "channel": { "enum": ["stable", "preview", "nightly"] },
        "keyIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/keyId" }
        },
        "mirrors": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/uri" }
        },
        "mirrorPolicy": { "enum": ["primary-only", "ordered-fallback"] }
      }
    },
    "trustKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "publicKey", "validFrom", "validUntil"],
      "properties": {
        "keyId": { "$ref": "#/definitions/keyId" },
        "algorithm": { "const": "ecdsa-p256-sha256" },
        "publicKey": { "type": "string", "pattern": "^[0-9a-fA-F]{128}$" },
        "validFrom": { "$ref": "#/definitions/timestamp" },
        "validUntil": { "$ref": "#/definitions/timestamp" }
      }
    }
  }
}
