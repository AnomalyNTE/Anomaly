{
  "schemaVersion": 2,
  "id": "anomaly.local.damage-dashboard",
  "name": "NTE Damage Dashboard",
  "description": "Combat statistics panel: metrics, bar charts (character/skill/buff/taken), health, shield and crit bars, height always fits the content (no scrollbars), draggable width. Same-name skills are merged and only the characters I control are counted.",
  "author": "Haaland-a",
  "license": "AGPL-3.0-only",
  "version": "2.7.1",
  "audience": "user",
  "entry": "plugin.dll",
  "api": {"major": 1, "minMinor": 0, "maxMinor": 0},
  "games": ["nte"],
  "builds": ["nte-*"],
  "loadPhase": "game-ready",
  "services": [
    {"id": "anomaly.ui", "minVersion": 1},
    {"id": "anomaly.localization", "minVersion": 1},
    {"id": "anomaly.core", "minVersion": 1, "optional": true},
    {"id": "anomaly.diagnostics", "minVersion": 1, "optional": true},
    {"id": "anomaly.notifications", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.combat", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.session", "minVersion": 1, "optional": true},
    {"id": "anomaly.json", "minVersion": 1, "optional": true},
    {"id": "anomaly.config", "minVersion": 1, "optional": true}
  ],
  "capabilities": [
    "ui",
    "configuration",
    "nte-combat-read",
    "nte-session-snapshot"
  ]
}
