{
  "schemaVersion": 2,
  "id": "anomaly.builtin.better-pose",
  "name": "Better Pose",
  "description": "Adjusts the local player skeletal mesh animation rate, pause state, root-motion scale, and applies best-effort component-space bone pose offsets.",
  "author": "Anomaly",
  "license": "AGPL-3.0-only",
  "version": "1.0.0",
  "entry": "plugin.dll",
  "api": {"major": 1, "minMinor": 0, "maxMinor": 0},
  "games": ["nte"],
  "builds": ["nte-*"],
  "loadPhase": "game-ready",
  "services": [
    {"id": "anomaly.core", "minVersion": 1},
    {"id": "anomaly.config", "minVersion": 1},
    {"id": "anomaly.storage", "minVersion": 1},
    {"id": "anomaly.scheduler", "minVersion": 1, "optional": true},
    {"id": "anomaly.interop.signature", "minVersion": 1},
    {"id": "anomaly.interop.hook", "minVersion": 1},
    {"id": "anomaly.ue5.names", "minVersion": 1},
    {"id": "anomaly.ue5.objects", "minVersion": 1},
    {"id": "anomaly.ui", "minVersion": 1},
    {"id": "anomaly.localization", "minVersion": 1},
    {"id": "anomaly.ue5.ahud", "minVersion": 1, "optional": true},
    {"id": "anomaly.input", "minVersion": 1, "optional": true}
  ],
  "capabilities": ["configuration", "storage", "scheduler", "interop-signature", "interop-hook", "memory-read", "memory-write", "ui",
    "ue5-names", "ue5-objects", "ue5-ahud", "input"]
}