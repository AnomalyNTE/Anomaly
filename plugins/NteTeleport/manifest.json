{
  "schemaVersion": 2,
  "id": "anomaly.builtin.nte-teleport",
  "name": "Teleport",
  "description": "Teleports the current player to entered or saved world coordinates.",
  "author": "Anomaly",
  "license": "AGPL-3.0-only",
  "audience": "developer",
  "version": "1.5.0",
  "entry": "plugin.dll",
  "api": {"major": 1, "minMinor": 0, "maxMinor": 0},
  "games": ["nte"],
  "builds": ["nte-*"],
  "loadPhase": "game-ready",
  "services": [
    {"id": "anomaly.ui", "minVersion": 1},
    {"id": "anomaly.config", "minVersion": 1},
    {"id": "anomaly.input", "minVersion": 1, "optional": true},
    {"id": "anomaly.json", "minVersion": 1, "optional": true},
    {"id": "anomaly.scheduler", "minVersion": 1, "optional": true},
    {"id": "anomaly.plugin-state", "minVersion": 1, "optional": true},
    {"id": "anomaly.core", "minVersion": 1, "optional": true},
    {"id": "anomaly.interop.signature", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.session", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.player", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.player-teleport", "minVersion": 1, "optional": true}
  ],
  "capabilities": ["ui", "configuration", "input", "json", "scheduler", "memory-read", "interop-signature", "nte-session-snapshot", "nte-player-snapshot", "nte-player-teleport"]
}
