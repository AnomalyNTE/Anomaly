    },
    {
      "id": "anomaly.scheduler",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.session",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.player",
      "minVersion": 1,
      "optional": true
