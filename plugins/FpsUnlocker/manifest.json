{
  "schemaVersion": 2,
  "id": "b1ank.fps-unlocker",
  "name": "FPS Unlocker",
  "description": "Removes the UE frame rate cap, remembers the toggle, and restores the original cap when switched off.",
  "author": "b1ank",
  "license": "AGPL-3.0-only",
  "version": "0.1.5",
  "entry": "plugin.dll",
  "api": {"major": 1, "minMinor": 0, "maxMinor": 0},
  "games": ["nte"],
  "builds": ["nte-*"],
  "loadPhase": "game-ready",
  "services": [
    {"id": "anomaly.ui", "minVersion": 1},
    {"id": "anomaly.localization", "minVersion": 1},
    {"id": "anomaly.window", "minVersion": 1},
    {"id": "anomaly.core", "minVersion": 1, "optional": true},
    {"id": "anomaly.config", "minVersion": 1},
    {"id": "anomaly.scheduler", "minVersion": 1},
    {"id": "anomaly.ue5.objects", "minVersion": 1, "optional": true},
    {"id": "anomaly.ue5.process-event", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.player", "minVersion": 1, "optional": true}
  ],
  "capabilities": ["ui", "ui-window", "configuration", "scheduler", "ue5-objects", "game-events", "nte-player-snapshot"]
}
