{
  "schemaVersion": 2,
  "id": "anomaly.builtin.pink-paw-heist-esp",
  "name": "Pink Paw Heist ESP",
  "description": "Displays Pink Paw Heist loot and extraction points with value filters, teleport, and pickup controls.",
  "author": "Anomaly",
  "license": "AGPL-3.0-only",
  "version": "1.11.0",
  "entry": "plugin.dll",
  "api": {"major": 1, "minMinor": 0, "maxMinor": 0},
  "games": ["nte"],
  "builds": ["nte-*"],
  "loadPhase": "game-ready",
  "services": [
    {"id": "anomaly.ui", "minVersion": 1},
    {"id": "anomaly.config", "minVersion": 1},
    {"id": "anomaly.interop.signature", "minVersion": 1},
    {"id": "anomaly.ue5.framework", "minVersion": 1},
    {"id": "anomaly.ue5.ahud", "minVersion": 1},
    {"id": "anomaly.ue5.names", "minVersion": 1},
    {"id": "anomaly.ue5.objects", "minVersion": 1, "optional": true},
