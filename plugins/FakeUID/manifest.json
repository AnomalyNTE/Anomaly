{
  "schemaVersion": 2,
  "id": "anomaly.local.nte.fake-uid",
  "name": "Custom UID",
  "description": "Customizes the UID displayed by the NTE client without changing account data.",
  "author": "Anomaly",
  "license": "AGPL-3.0-only",
  "version": "1.1.4",
  "entry": "plugin.dll",
  "api": {"major": 1, "minMinor": 0, "maxMinor": 0},
  "games": ["nte"],
  "builds": ["nte-*"],
  "loadPhase": "game-ready",
  "services": [
    {"id": "anomaly.config", "minVersion": 1},
    {"id": "anomaly.interop.signature", "minVersion": 1},
    {"id": "anomaly.scheduler", "minVersion": 1},
    {"id": "anomaly.ui", "minVersion": 1, "optional": true},
    {"id": "anomaly.window", "minVersion": 1, "optional": true},
    {"id": "anomaly.ue5.names", "minVersion": 1},
    {"id": "anomaly.ue5.objects", "minVersion": 1}
  ],
  "capabilities": [
    "configuration", "interop-signature", "scheduler", "ui", "ui-window",
    "ue5-names", "ue5-objects"
  ]
}
