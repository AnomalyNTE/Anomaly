{
  "schemaVersion": 2,
  "id": "local.nte.free-fly",
  "name": "Free Fly",
  "description": "Hold WASD to move horizontally, Space to ascend and Ctrl to descend: the character flies freely and passes through walls.",
  "author": "Mou-Mou-SaMa",
  "license": "MIT",
  "audience": "user",
  "version": "1.6.0",
  "entry": "plugin.dll",
  "api": {"major": 1, "minMinor": 0, "maxMinor": 0},
  "games": ["nte"],
  "builds": ["nte-*"],
  "loadPhase": "game-ready",
  "services": [
    {"id": "anomaly.core", "minVersion": 1},
    {"id": "anomaly.ui", "minVersion": 1},
    {"id": "anomaly.localization", "minVersion": 1},
    {"id": "anomaly.input", "minVersion": 1},
    {"id": "anomaly.config", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.session", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.player", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.player-teleport", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.player-hold", "minVersion": 1, "optional": true}
  ],
  "capabilities": [
    "ui",
    "input",
    "configuration",
    "nte-session-snapshot",
    "nte-player-snapshot",
    "nte-player-teleport",
    "nte-player-hold"
  ]
}
