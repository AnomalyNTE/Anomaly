{
  "schemaVersion": 2,
  "id": "anomaly.equipment-manager",
  "name": "Equipment Manager",
  "description": "Read the live equipment inventory, apply loadouts through native RPCs and confirm server inventory updates from a web interface",
  "author": "Anomaly",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "entry": "plugin.dll",
  "api": {"major": 1, "minMinor": 0, "maxMinor": 0},
  "games": ["nte"],
  "builds": ["nte-*"],
  "loadPhase": "game-ready",
  "services": [
    {"id": "anomaly.core", "minVersion": 1},
    {"id": "anomaly.localization", "minVersion": 1},
    {"id": "anomaly.ui", "minVersion": 1},
    {"id": "anomaly.config", "minVersion": 1},
    {"id": "anomaly.plugin-state", "minVersion": 1},
    {"id": "anomaly.scheduler", "minVersion": 1},
    {"id": "anomaly.runtime-info", "minVersion": 1},
    {"id": "anomaly.ipc", "minVersion": 1, "optional": true},
    {"id": "anomaly.web", "minVersion": 1},
    {"id": "anomaly.profile", "minVersion": 1},
    {"id": "anomaly.json", "minVersion": 1},
    {"id": "anomaly.interop.signature", "minVersion": 1},
    {"id": "anomaly.ue5.names", "minVersion": 1},
    {"id": "anomaly.ue5.objects", "minVersion": 1},
    {"id": "anomaly.ue5.framework", "minVersion": 1},
    {"id": "anomaly.ue5.process-event", "minVersion": 1},
    {"id": "anomaly.nte.player", "minVersion": 1},
    {"id": "anomaly.nte.session", "minVersion": 1},
    {"id": "anomaly.nte.account", "minVersion": 1, "optional": true}
  ],
  "capabilities": [
    "memory-read", "ui", "configuration", "scheduler", "runtime-info", "ipc", "web", "json",
    "interop-signature", "ue5-names", "ue5-objects", "game-events",
    "nte-player-snapshot", "nte-session-snapshot", "nte-account-read"
  ]
}
