      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.ue5.objects",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.ue5.process-event",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.player",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.input",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.storage",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.scheduler",
      "minVersion": 1,
      "optional": true
    }
