    "nte-*"
  ],
  "loadPhase": "game-ready",
  "services": [
    {
      "id": "anomaly.core",
      "minVersion": 1
    },
    {
      "id": "anomaly.config",
      "minVersion": 1
    },
    {
      "id": "anomaly.interop.signature",
      "minVersion": 1
    },
    {
      "id": "anomaly.interop.hook",
      "minVersion": 1
    },
    {
      "id": "anomaly.ue5.names",
      "minVersion": 1
    },
    {
      "id": "anomaly.profile",
      "minVersion": 1
    },
    {
      "id": "anomaly.json",
      "minVersion": 1
    },
    {
      "id": "anomaly.scheduler",
      "minVersion": 1
    },
    {
      "id": "anomaly.localization",
      "minVersion": 1
    },
    {
      "id": "anomaly.ui",
      "minVersion": 1
    },
    {
      "id": "anomaly.ue5.objects",
      "minVersion": 1
    },
    {
      "id": "anomaly.ue5.process-event",
      "minVersion": 1
    },
    {
      "id": "anomaly.ue5.world",
      "minVersion": 1,
