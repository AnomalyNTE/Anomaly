{
  "schemaVersion": 2,
  "id": "anomaly.local.combat-box",
  "name": "Combat Resource Points",
  "description": "Combat resource points: combat treasure boxes (Gift of XX points) via table teleport, and anomaly furniture material (6 anomaly monsters) via hardcoded teleport, with local cache marking after defeat.",
  "author": "CCYellowStar",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "entry": "plugin.dll",
  "api": {"major": 1, "minMinor": 0, "maxMinor": 0},
  "games": ["nte"],
  "builds": ["nte-*"],
  "loadPhase": "game-ready",
  "services": [
    {"id": "anomaly.core", "minVersion": 1},
    {"id": "anomaly.ui", "minVersion": 1},
    {"id": "anomaly.localization", "minVersion": 1},
    {"id": "anomaly.plugin-state", "minVersion": 1},
    {"id": "anomaly.interop.signature", "minVersion": 1},
    {"id": "anomaly.ue5.names", "minVersion": 1},
    {"id": "anomaly.ue5.objects", "minVersion": 1},
    {"id": "anomaly.nte.session", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.player", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.navigation", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.map-landmarks", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.player-teleport", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.combat", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.skills", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.skill-invocation", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.actors", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.entities", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.pickup", "minVersion": 1, "optional": true}
  ],
  "capabilities": [
    "ui",
    "memory-read",
    "interop-signature",
    "ue5-names",
    "ue5-objects",
    "configuration",
    "nte-session-snapshot",
    "nte-player-snapshot",
    "nte-navigation",
    "nte-map-landmarks",
    "nte-player-teleport",
    "nte-combat-read",
    "nte-skills-read",
    "nte-skill-invocation",
    "nte-actor-snapshot",
    "nte-entity-snapshot",
    "nte-pickup"
  ]
}
