{
  "schemaVersion": 2,
  "id": "b1ank.scene-loader",
  "name": "场景加载器",
  "description": "列出游戏场景，使用已配置的游戏入口切换场景。",
  "author": "b1ank, CCYellowStar",
  "license": "AGPL-3.0-only",
  "version": "0.1.6",
  "entry": "plugin.dll",
  "api": {"major": 1, "minMinor": 0, "maxMinor": 0},
  "games": ["nte"],
  "builds": ["nte-*"],
  "loadPhase": "game-ready",
  "services": [
    {"id": "anomaly.core", "minVersion": 1},
    {"id": "anomaly.ui", "minVersion": 1},
    {"id": "anomaly.window", "minVersion": 1, "optional": true},
    {"id": "anomaly.ue5.names", "minVersion": 2},
    {"id": "anomaly.ue5.objects", "minVersion": 1},
    {"id": "anomaly.ue5.framework", "minVersion": 1},
    {"id": "anomaly.ue5.world", "minVersion": 1},
    {"id": "anomaly.ue5.process-event", "minVersion": 1, "optional": true},
    {"id": "anomaly.interop.signature", "minVersion": 1}
  ],
  "capabilities": ["ui", "ui-window", "memory-read", "memory-write", "ue5-names", "ue5-objects", "ue5-world", "game-events", "interop-signature"]
}
