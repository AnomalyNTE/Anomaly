{
  "schemaVersion": 2,
  "id": "wawmew.night999",
  "name": "Night 999",
  "description": "Night 999 script: a fully automatic monster farming loop - teleport to camp, refresh monsters, teleport to fight point 1, auto combat, teleport to fight point 2, auto combat, back to camp, repeated for the configured number of rounds (0 = unlimited). Intended for the Night 999 Crimson Dragon Castle map; neither refreshing nor combat needs any UI open.",
  "author": "WawMew",
  "license": "AGPL-3.0-only",
  "audience": "user",
  "version": "0.21.0",
  "entry": "plugin.dll",
  "api": {
    "major": 1,
    "minMinor": 0,
    "maxMinor": 0
  },
  "games": [
    "nte"
  ],
  "builds": [
    "nte-*"
  ],
  "loadPhase": "game-ready",
  "services": [
    {
      "id": "anomaly.core",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.ui",
      "minVersion": 1
    },
    {
      "id": "anomaly.localization",
      "minVersion": 1
    },
    {
      "id": "anomaly.nte.session",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.player",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.player-teleport",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.navigation",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.combat",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.skills",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.skill-invocation",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.actors",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.entities",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.pickup",
      "minVersion": 1,
      "optional": true
