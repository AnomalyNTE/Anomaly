{
  "schemaVersion": 2,
  "id": "anomaly.local.nte.night999",
  "name": "999夜脚本",
  "description": "999夜脚本：先传送到指定地点，再刷新怪物并自动战斗，清怪后回到传送点循环。当前版本实现前三步——传送到指定世界坐标、一键刷新怪物（按对象路径定位、逐座营火发送，不需打开营地），以及自动战斗：技能优先（大招→小技能，按冷却判定）、没有可放技能时平A，平A/小技能/大招各可勾选，打完（连续无怪或长时间无伤害）自动结束。",
  "author": "WawMew",
  "license": "AGPL-3.0-only",
  "audience": "user",
  "version": "0.13.0",
  "entry": "plugin.dll",
  "api": {"major": 1, "minMinor": 0, "maxMinor": 0},
  "games": ["nte"],
  "builds": ["nte-*"],
  "loadPhase": "game-ready",
  "services": [
