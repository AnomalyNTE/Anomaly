{
  "schemaVersion": 2,
  "id": "anomaly.local.nte.night999",
  "name": "999夜脚本",
  "description": "999夜脚本：全自动刷怪循环——传送到营地 → 刷新怪物 → 传送到1号战斗点 → 自动战斗 → 传送到2号战斗点 → 自动战斗 → 回到营地，按设定次数循环（0 为无限）。",
  "author": "WawMew",
  "license": "AGPL-3.0-only",
  "audience": "user",
  "version": "0.16.0",
  "entry": "plugin.dll",
  "api": {"major": 1, "minMinor": 0, "maxMinor": 0},
  "games": ["nte"],
  "builds": ["nte-*"],
  "loadPhase": "game-ready",
  "services": [
    {"id": "anomaly.core", "minVersion": 1, "optional": true},
    {"id": "anomaly.ui", "minVersion": 1},
    {"id": "anomaly.nte.session", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.player", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.player-teleport", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.navigation", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.combat", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.skills", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.skill-invocation", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.actors", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.entities", "minVersion": 1, "optional": true},
    {"id": "anomaly.nte.pickup", "minVersion": 1, "optional": true},
    {"id": "anomaly.ue5.names", "minVersion": 2, "optional": true},
    {"id": "anomaly.ue5.objects", "minVersion": 1, "optional": true},
    {"id": "anomaly.ue5.world", "minVersion": 1, "optional": true},
    {"id": "anomaly.ue5.framework", "minVersion": 1, "optional": true},
    {"id": "anomaly.ue5.process-event", "minVersion": 1, "optional": true},
    {"id": "anomaly.interop.signature", "minVersion": 1, "optional": true}
  ],
  "capabilities": ["ui", "memory-read", "game-events", "ue5-names", "ue5-objects", "ue5-world", "interop-signature", "nte-session-snapshot", "nte-player-snapshot", "nte-player-teleport", "nte-navigation", "nte-combat-read", "nte-skills-read", "nte-skill-invocation", "nte-actor-snapshot", "nte-entity-snapshot", "nte-pickup"]
}
