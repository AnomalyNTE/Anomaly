{
  "schemaVersion": 2,
  "id": "anomaly.summon-lab",
  "name": "Summon Lab",
  "description": "Summon characters with gameplay attributes initialized during native spawning, before spawn completion",
  "author": "Anomaly",
  "license": "AGPL-3.0-only",
  "audience": "user",
  "version": "1.0.0",
  "entry": "plugin.dll",
  "api": {
    "major": 1,
    "minMinor": 0,
    "maxMinor": 0
  },
  "games": [
    "nte"
  ],
  "builds": [
    "nte-*"
  ],
  "loadPhase": "game-ready",
  "services": [
    {
      "id": "anomaly.ui",
      "minVersion": 1
    },
    {
      "id": "anomaly.localization",
      "minVersion": 1
    },
    {
      "id": "anomaly.core",
      "minVersion": 1
    },
    {
      "id": "anomaly.config",
      "minVersion": 1
    },
    {
      "id": "anomaly.profile",
      "minVersion": 1
    },
    {
      "id": "anomaly.json",
      "minVersion": 1
    },
    {
      "id": "anomaly.ue5.objects",
      "minVersion": 1
    },
    {
      "id": "anomaly.ue5.names",
      "minVersion": 2
    },
    {
      "id": "anomaly.ue5.process-event",
      "minVersion": 1
    },
    {
      "id": "anomaly.nte.session",
      "minVersion": 1
    },
    {
      "id": "anomaly.nte.player",
      "minVersion": 1
    },
    {
      "id": "anomaly.interop.signature",
      "minVersion": 1
    },
    {
      "id": "anomaly.interop.hook",
      "minVersion": 1
    },
    {
      "id": "anomaly.ue5.assets",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.scheduler",
      "minVersion": 1
    },
    {
      "id": "anomaly.storage",
      "minVersion": 1
    }
  ],
  "capabilities": [
    "ui",
    "json",
    "game-events",
    "ue5-objects",
    "ue5-names",
    "nte-session-snapshot",
    "nte-player-snapshot",
    "memory-read",
    "memory-write",
    "interop-signature",
    "interop-hook",
    "ue5-assets",
    "scheduler",
    "storage",
    "configuration"
  ]
}
