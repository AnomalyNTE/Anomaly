{
  "schemaVersion": 2,
  "id": "anomaly.haunted-house",
  "name": "Haunted House",
  "description": "Teleports the local player through the haunted-house event: a numbered 18-step main flow (castle hall, exploration, seals, ice cream, candy, four gems and their hand-ins, candy key, visiting the count) with one-click completion and a boss-room shortcut; the flyer, battery, sanity spray, and gingerbread pages are filled only when you press Scan, then each instance gets its own teleport.",
  "author": "Anomaly",
  "license": "AGPL-3.0-only",
  "version": "1.0.0",
  "entry": "plugin.dll",
  "api": {
    "major": 1,
    "minMinor": 0,
    "maxMinor": 0
  },
  "games": [
    "nte"
  ],
  "builds": [
    "nte-*"
  ],
  "loadPhase": "game-ready",
  "services": [
    {
      "id": "anomaly.config",
      "minVersion": 1
    },
    {
      "id": "anomaly.ui",
      "minVersion": 1
    },
    {
      "id": "anomaly.localization",
      "minVersion": 1
    },
    {
      "id": "anomaly.core",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.session",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.player",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.player-teleport",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.actors",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.ui-buttons",
      "minVersion": 1,
      "optional": true
    }
  ],
  "capabilities": [
    "configuration",
    "ui",
    "nte-session-snapshot",
    "nte-player-snapshot",
    "nte-player-teleport",
    "nte-actor-snapshot",
    "nte-ui-buttons"
  ]
}
